ve'a yazılır\n","└── adapter_best/         ← eğitim sonunda buraya kaydedilir\n","```\n"]},{"cell_type":"code","metadata":{"id":"setup","executionInfo":{"status":"ok","timestamp":1784902677887,"user_tz":-180,"elapsed":5009,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}}},"source":["!pip install -q -U transformers datasets peft bitsandbytes accelerate trl\n"],"execution_count":12,"outputs":[]},{"cell_type":"code","source":["from google.colab import drive\n","from pathlib import Path\n","import shutil\n","import json\n","\n","drive.mount(\"/content/drive\")\n","\n","DRIVE_DIR = Path(\"/content/drive/MyDrive/CerberusVision_Phase5_Colab\")\n","DATA_DIR = DRIVE_DIR / \"data\"\n","CHECKPOINT_DIR = DRIVE_DIR / \"checkpoints\"\n","FINAL_ADAPTER_DIR = DRIVE_DIR / \"adapter_best\"\n","\n","LOCAL_DATA_DIR = Path(\"/content/phase5_data\")\n","\n","for d in [DATA_DIR, CHECKPOINT_DIR, FINAL_ADAPTER_DIR, LOCAL_DATA_DIR]:\n","    d.mkdir(parents=True, exist_ok=True)\n","\n","print(\"Drive mount tamam. Dizinler hazır.\")\n","print(f\"  Veri (Drive):      {DATA_DIR}\")\n","print(f\"  Checkpoint (Drive): {CHECKPOINT_DIR}\")\n","print(f\"  Final adapter:      {FINAL_ADAPTER_DIR}\")\n","print(f\"  Veri (lokal):       {LOCAL_DATA_DIR}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sdy758nCfNuh","executionInfo":{"status":"ok","timestamp":1784902678962,"user_tz":-180,"elapsed":1059,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}},"outputId":"812d5d6c-d51b-47c6-95b2-fdf9cf28e1e7"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Drive mount tamam. Dizinler hazır.\n","  Veri (Drive):      /content/drive/MyDrive/CerberusVision_Phase5_Colab/data\n","  Checkpoint (Drive): /content/drive/MyDrive/CerberusVision_Phase5_Colab/checkpoints\n","  Final adapter:      /content/drive/MyDrive/CerberusVision_Phase5_Colab/adapter_best\n","  Veri (lokal):       /content/phase5_data\n"]}]},{"cell_type":"code","metadata":{"id":"imports","colab":{"base_uri":"https://localhost:8080/","height":84,"referenced_widgets":["6499502957a44c1485a5d826af79a24a","b58200e5e9e94516afe3bdb819089485","f1cf51cab50b4e328ccb263c32e3c784","8e661100674f4fa6bccef765ad92f427","f06e67d3ee1a467f8fb42158d842c31a","53410ad3f96b431da13eca6b11ae5743","2bbe713918ef4fafb2d82dcfe7f52d42","e4bb57eee71147fd947ecbe3353ad58c","0114075f313643eb86bd9facdbe3985c","ee738d6a70e2426b803c9a8de352233a","d81a576af71f481080f16de9bdc195e7"]},"executionInfo":{"status":"ok","timestamp":1784902686142,"user_tz":-180,"elapsed":7173,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}},"outputId":"b53bff7c-a974-4451-da1d-6fcd4214bb5a"},"source":["import torch\n","from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n","from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n","from datasets import load_dataset\n","from trl import SFTTrainer, SFTConfig\n","\n","model_id = \"Qwen/Qwen2.5-7B-Instruct\"\n","use_bf16 = torch.cuda.is_bf16_supported()\n","compute_dtype = torch.bfloat16 if use_bf16 else torch.float16\n","\n","bnb_config = BitsAndBytesConfig(\n","    load_in_4bit=True,\n","    bnb_4bit_quant_type=\"nf4\",\n","    bnb_4bit_compute_dtype=compute_dtype,\n","    bnb_4bit_use_double_quant=True\n",")\n","\n","model = AutoModelForCausalLM.from_pretrained(model_id, quantization_config=bnb_config, device_map=\"auto\")\n","model = prepare_model_for_kbit_training(model)\n","tokenizer = AutoTokenizer.from_pretrained(model_id)\n","if tokenizer.pad_token is None:\n","    tokenizer.add_special_tokens({'pad_token': '<|endoftext|>'})\n","\n","print(\"PAD Token ID:\", tokenizer.pad_token_id)\n","print(\"EOS Token ID:\", tokenizer.eos_token_id)\n","assert tokenizer.pad_token_id != tokenizer.eos_token_id\n","assert tokenizer.eos_token == \"<|im_end|>\"\n"],"execution_count":14,"outputs":[{"output_type":"display_data","data":{"text/plain":["Loading weights:   0%|          | 0/339 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6499502957a44c1485a5d826af79a24a"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["PAD Token ID: 151643\n","EOS Token ID: 151645\n"]}]},{"cell_type":"code","source":["expected_files = {\n","    \"phase5_train.jsonl\": \"1043 ornek, 10 belge ailesi (~2.7 MB)\",\n","    \"phase5_validation.jsonl\": \"75 ornek, 1 belge ailesi (~341 KB)\",\n","}\n","\n","missing = []\n","for filename, desc in expected_files.items():\n","    source = DATA_DIR / filename\n","    destination = LOCAL_DATA_DIR / filename\n","    if not source.exists():\n","        missing.append((filename, desc))\n","        continue\n","    shutil.copy2(source, destination)\n","    print(f\"Kopyalandi: {filename} ({desc})\")\n","\n","if missing:\n","    print(\"\\n*** EKSIK DOSYALAR — Google Drive'a yuklemen gerekiyor ***\\n\")\n","    print(f\"Hedef klasor: {DATA_DIR}\")\n","    print()\n","    for filename, desc in missing:\n","        print(f\"  • {filename}  ({desc})\")\n","    print()\n","    print(\"Bu dosyalar projenin CerberusVision_Phase5_Colab/ dizininde mevcut.\")\n","    print(\"Drive'ta yukaridaki klasore yukleyip bu hucreyi tekrar calistir.\")\n","    raise FileNotFoundError(f\"{len(missing)} dosya Drive'da bulunamadi. Yukaridaki listeyi kontrol et.\")\n","\n","print(\"\\nVeriler Drive'dan lokal /content calisma alanina tasindi.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lM_-sRkjfNui","executionInfo":{"status":"ok","timestamp":1784902686171,"user_tz":-180,"elapsed":19,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}},"outputId":"94208c35-3292-4d40-d4a7-0eab85f2d52d"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["Kopyalandi: phase5_train.jsonl (1043 ornek, 10 belge ailesi (~2.7 MB))\n","Kopyalandi: phase5_validation.jsonl (75 ornek, 1 belge ailesi (~341 KB))\n","\n","Veriler Drive'dan lokal /content calisma alanina tasindi.\n"]}]},{"cell_type":"code","metadata":{"id":"data_prep","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1784902687140,"user_tz":-180,"elapsed":967,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}},"outputId":"9223c45c-7816-48b4-98e7-04f6fe2eedc5"},"source":["train_dataset = load_dataset(\"json\", data_files=str(LOCAL_DATA_DIR / \"phase5_train.jsonl\"), split=\"train\")\n","eval_dataset = load_dataset(\"json\", data_files=str(LOCAL_DATA_DIR / \"phase5_validation.jsonl\"), split=\"train\")\n","\n","def format_dataset(example):\n","    return {\n","        \"prompt\": [\n","            {\"role\": \"system\", \"content\": \"Extract shipping instruction data from OCR text as JSON.\"},\n","            {\"role\": \"user\", \"content\": str(example['input'])}\n","        ],\n","        \"completion\": [\n","            {\"role\": \"assistant\", \"content\": str(example['output'])}\n","        ]\n","    }\n","\n","train_dataset = train_dataset.map(format_dataset, remove_columns=train_dataset.column_names)\n","eval_dataset = eval_dataset.map(format_dataset, remove_columns=eval_dataset.column_names)\n","print(f\"Train size: {len(train_dataset)}, Eval size: {len(eval_dataset)}\")"],"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Train size: 1043, Eval size: 75\n"]}]},{"cell_type":"code","metadata":{"id":"training","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1784902687739,"user_tz":-180,"elapsed":589,"user":{"displayName":"Real Hades Hadesoğlu","userId":"13601492606808208859"}},"outputId":"56289a26-cd59-4f20-bcb6-7f0607edc967"},"source":["lora_config = LoraConfig(\n","    r=16,\n","    lora_alpha=32,\n","    target_modules